# ==============================================================================
# DeepSeek Harness Profile Patch Layer (cordis.patch.yml)
# Part of: DeepSeek Harness Local LLM Suite (github.com/geadalfa/deepseek-harness-local-llm-suite)
# Persona: Gemi AI
# ==============================================================================
- id: agent-default-model
  name: "@deepseek-ai/dsh-agent-default-model"
  config:
    provider: tabbyapi
    model: Qwen2.5-Coder-7B-Instruct-exl2-4_25

- id: ui-settings-account
  name: "@deepseek-ai/dsh-client-ui-settings-account"
  config:
    version: 1
    step: done
    purpose: both
    process: detailed
    completion: completed
    usage: detailed
    developerTools: true

- id: ui-chat
  name: "@deepseek-ai/dsh-client-ui-chat"
  config:
    transcriptView: detailed
    performanceUsage: detailed

- id: ui-settings
  name: "@deepseek-ai/dsh-client-ui-settings"
  config:
    enabled: true

- id: compaction-basic
  name: "@deepseek-ai/dsh-compaction-basic"
  config:
    headroomTokens: 2048
    maxTokens: 4096

- id: agent-instructions
  name: "@deepseek-ai/dsh-agent-instructions"
  config:
    maxBytes: 32768

- id: system-prompt
  name: "@deepseek-ai/dsh-system-prompt"
  config:
    personaPrefix: |
      You are Gemi, trusted high-performance AI coding and engineering partner across VS Code, Antigravity, and DeepSeek Harness.
      Address the user directly and professionally. Strictly NEVER use honorifics.
      Always adhere to zero-nausea gaming ergonomics when advising on game settings (FOV 90-105, Motion Blur 0%, Camera Shake 0%).
      Follow all anti-vibe-coding engineering protocols, tool dispatch matrices, and domain knowledge defined in AGENTS.md.

- id: tool-web
  name: "@deepseek-ai/dsh-tool-web"
  config:
    fetch: true
    searchTimeoutMs: 60000

- id: llm-pi-ai
  name: "@deepseek-ai/dsh-llm-pi-ai"
  config:
    providers:
      tabbyapi:
        displayName: "TabbyAPI EXL2 Turbo (64K Crisp)"
        api: openai-completions
        apiKeyEnv: OLLAMA_API_KEY
        baseURL: http://127.0.0.1:5000/v1
        defaultContextWindow: 65536
        defaultMaxTokens: 4096
        models:
          - id: Qwen2.5-Coder-7B-Instruct-exl2-4_25
            name: "Qwen 2.5 Coder 7B EXL2 (Turboderp 64K)"
            contextWindow: 65536
            maxTokens: 4096
      ollama:
        displayName: "Ollama Local (GGUF Suite)"
        api: openai-completions
        apiKeyEnv: OLLAMA_API_KEY
        baseURL: http://127.0.0.1:11434/v1
        defaultContextWindow: 131072
        defaultMaxTokens: 4096
        models:
          - id: deepseek-r1:7b
            name: "DeepSeek R1 Distill 7B"
            contextWindow: 131072
            maxTokens: 4096
          - id: qwen2.5-coder:7b
            name: "Qwen 2.5 Coder 7B"
            contextWindow: 131072
            maxTokens: 4096
          - id: qwen3.8:27b-ista-das
            name: "Qwen 3.8 27B ISTA-DASLab"
            contextWindow: 131072
            maxTokens: 4096

- insert:
    - id: mcp-duckduckgo
      name: "@deepseek-ai/dsh-mcp-client"
      config:
        serverName: duckduckgo-search
        transport: stdio
        command: npx.cmd
        args: [ "-y", "duckduckgo-mcp" ]
        failOnStartupError: false

    - id: mcp-github
      name: "@deepseek-ai/dsh-mcp-client"
      config:
        serverName: github
        transport: stdio
        command: npx.cmd
        args: [ "-y", "@modelcontextprotocol/server-github" ]
        env:
          GITHUB_PERSONAL_ACCESS_TOKEN: "{{GITHUB_TOKEN}}"
        failOnStartupError: false

    - id: mcp-financial
      name: "@deepseek-ai/dsh-mcp-client"
      config:
        serverName: financial-engine
        transport: stdio
        command: "{{PYTHON_EXECUTABLE}}"
        args: [ "{{LOCAL_LLM_DIR}}\\tools\\financial_mcp_server.py" ]
        failOnStartupError: false
