# DeepSeek Harness Profile Patch Layer (cordis.patch.yml)
# Default DeepSeek Harness settings & plugins preserved (full tools, time-context, and presets).
# Local LLM Providers: TabbyAPI (EXL2 Turbo) & Ollama (GGUF Suite).

- id: agent-default-model
  name: "@deepseek-ai/dsh-agent-default-model"
  config:
    provider: tabbyapi
    model: Qwen2.5-Coder-7B-Instruct-exl2-4_25

- id: ui-settings-account
  name: "@deepseek-ai/dsh-client-ui-settings-account"
  config:
    version: 1
    step: done
    purpose: both
    process: detailed
    completion: completed
    usage: detailed
    developerTools: true

- id: ui-chat
  name: "@deepseek-ai/dsh-client-ui-chat"
  config:
    transcriptView: detailed
    performanceUsage: detailed

- id: ui-settings
  name: "@deepseek-ai/dsh-client-ui-settings"
  config:
    enabled: true

- id: compaction-basic
  name: "@deepseek-ai/dsh-compaction-basic"
  config:
    headroomTokens: 2048
    maxTokens: 4096

- id: llm-pi-ai
  name: "@deepseek-ai/dsh-llm-pi-ai"
  config:
    providers:
      tabbyapi:
        displayName: "TabbyAPI EXL2 Turbo"
        api: openai-completions
        apiKeyEnv: OLLAMA_API_KEY
        baseURL: http://127.0.0.1:5000/v1
        defaultContextWindow: 131072
        defaultMaxTokens: 4096
        models:
          - id: Qwen2.5-Coder-7B-Instruct-exl2-4_25
            name: "Qwen 2.5 Coder 7B EXL2 (128K)"
            contextWindow: 131072
            maxTokens: 4096
          - id: Qwen2.5-7B-Instruct-1M-exl2-4_25
            name: "Qwen 2.5 7B Instruct 1M (128K)"
            contextWindow: 131072
            maxTokens: 4096
          - id: Mistral-Nemo-Instruct-2407-exl2-4_25
            name: "Mistral Nemo 12B Instruct (128K)"
            contextWindow: 131072
            maxTokens: 4096
          - id: Qwen2.5-14B-Instruct-1M-exl2-4_25
            name: "Qwen 2.5 14B Instruct 1M (64K)"
            contextWindow: 65536
            maxTokens: 4096
      ollama:
        displayName: "Ollama Local (RTX 4070 SUPER)"
        api: openai-completions
        apiKeyEnv: OLLAMA_API_KEY
        baseURL: http://127.0.0.1:11434/v1
        defaultContextWindow: 131072
        defaultMaxTokens: 4096
        models:
          - id: deepseek-r1:7b
            name: "DeepSeek R1 Distill 7B (128K)"
            contextWindow: 131072
            maxTokens: 4096
          - id: qwen2.5-coder:7b
            name: "Qwen 2.5 Coder 7B (128K)"
            contextWindow: 131072
            maxTokens: 4096
          - id: qwen3.8:27b-ista-das
            name: "Qwen 3.8 27B ISTA-DASLab (64K)"
            contextWindow: 65536
            maxTokens: 4096

- insert:
    - id: mcp-duckduckgo
      name: "@deepseek-ai/dsh-mcp-client"
      config:
        serverName: duckduckgo-search
        transport: stdio
        command: npx.cmd
        args: [ "-y", "duckduckgo-mcp" ]
        failOnStartupError: false
